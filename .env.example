# ---- Core ----
DATABASE_URL="postgresql://user:password@localhost:5432/nyayalink_db?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → URL: https://<domain>/api/payments/webhook
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# ---- GST invoicing (supplier details printed on tax invoices) ----
NEXT_PUBLIC_SUPPLIER_STATE="MH"
SUPPLIER_LEGAL_NAME="NyayaLink Legal Services Pvt Ltd"
SUPPLIER_GSTIN=""
SUPPLIER_ADDRESS=""

# ---- Email (Resend) — also used for email OTP ----
RESEND_API_KEY=""
EMAIL_FROM="NyayaLink <no-reply@yourdomain.com>"
# Receives client messages on unassigned orders
OPS_EMAIL=""

# ---- SMS OTP (MSG91, DLT-approved template containing ##OTP##) ----
# Without these, SMS codes are printed to the server console in development and disabled in production.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# ---- Private document storage ----
# Set S3_BUCKET to use S3 (required on serverless hosts). Otherwise files go to PRIVATE_STORAGE_DIR on local disk.
S3_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
PRIVATE_STORAGE_DIR=""
