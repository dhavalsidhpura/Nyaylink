# Copy this file to .env.local for local development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RESEND_API_KEY="re_your_key"
EMAIL_FROM="NyayLink <notifications@yourdomain.in>"
REMINDER_CRON_SECRET="generate-a-separate-random-cron-secret"
PRIVATE_UPLOAD_DIR=".private-data/uploads"
