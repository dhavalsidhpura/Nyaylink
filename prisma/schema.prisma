datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  OPS_MANAGER
  CA_CS_LEAD
  COMPLIANCE_EXEC
  FINANCE_MANAGER
  LAWYER
  CLIENT
}

enum OrderStatus {
  PENDING_PAYMENT
  DOCS_PENDING
  IN_PROGRESS
  QUERY_RAISED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentKind {
  FULL // professional fee + govt fee + GST, collected at checkout
  MILESTONE // additional instalment requested by ops (e.g. extra govt fee / stamp duty)
  CONSULTATION // वकील Search consultation booking
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISQUALIFIED
}

enum DocStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum TxnType {
  CLIENT_PAYMENT
  GOVT_FEES_DEBIT
  CA_PAYOUT
  LAWYER_PAYOUT
  REFUND
}

enum LawyerVerification {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ConsultationMode {
  VIDEO
  PHONE
  IN_PERSON
}

enum ConsultationStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PayoutStatus {
  PENDING
  PAID
}

// ==========================================
// IDENTITY, AUTH & CONSENT (DPDP)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  password      String? // null for OTP-only accounts
  role          Role      @default(CLIENT)
  state         String? // billing state code (e.g. "MH") — drives CGST/SGST vs IGST
  gstin         String?
  emailVerified DateTime?
  phoneVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders         Order[]          @relation("ClientOrders")
  assignedOrders Order[]          @relation("AssignedCAOrders")
  documents      VaultDocument[]  @relation("DocumentOwner")
  reviewedDocs   VaultDocument[]  @relation("DocumentReviewer")
  leads          Lead[]           @relation("AssignedLeads")
  statusLogs     OrderStatusLog[]
  messages       OrderMessage[]
  consents       Consent[]
  accessLogs     DocumentAccessLog[]
  lawyerProfile  LawyerProfile?
  consultations  Consultation[]   @relation("ClientConsultations")

  // ERP / Multi-tenancy & Back-office relations (Additive)
  orgMemberships     OrganizationMember[]
  createdQuotes      Quote[]              @relation("QuoteCreator")
  clientQuotes       Quote[]              @relation("ClientQuotes")
  leadMatters        Matter[]             @relation("AssignedLeadMatters")
  execMatters        Matter[]             @relation("AssignedExecMatters")
  assignedTasks      MatterTask[]
  uploadedEvidence   MatterEvidence[]
  createdJournals    JournalEntry[]       @relation("JournalCreator")
  approvedJournals   JournalEntry[]       @relation("JournalApprover")
  requestedApprovals ApprovalRequest[]   @relation("ApprovalRequester")
  reviewedApprovals  ApprovalRequest[]    @relation("ApprovalReviewer")
  auditLogs          AuditLog[]
  reviewedEvidences  StatutoryEvidence[]  @relation("EvidenceReviewer")
}

model OtpCode {
  id         String    @id @default(cuid())
  identifier String // normalised email or +91 phone
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  purpose   String // e.g. "TERMS_PRIVACY", "KYC_PROCESSING"
  version   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lead {
  id             String     @id @default(cuid())
  fullName       String
  email          String?
  phone          String
  source         String     @default("Website Intake")
  complianceType String
  status         LeadStatus @default(NEW)
  assignedToId   String?
  assignedTo     User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdAt      DateTime   @default(now())

  quotes         Quote[]
}

// Monotonic counters for gap-free invoice numbers and readable order numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ==========================================
// SERVICE CATALOG (single source of truth for pricing)
// ==========================================

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String
  professionalFee Decimal  @db.Decimal(12, 2)
  govtFee         Decimal  @default(0) @db.Decimal(12, 2) // fixed govt fee collected upfront (pass-through, no GST)
  govtFeeNote     String
  gstRate         Decimal  @default(18) @db.Decimal(5, 2)
  sla             String
  sacCode         String   @default("998221")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders       Order[]
  requirements ServiceDocRequirement[]
  bundleItems  BundleItem[]
  quotes       Quote[]
}

model ServiceDocRequirement {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key       String
  label     String
  required  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([serviceId, key])
}

// ==========================================
// ORDERS, PAYMENTS, INVOICES
// ==========================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  srn             String?       @unique // government SRN / ARN — set by the CA once issued
  idempotencyKey  String?       @unique
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  clientId        String
  client          User          @relation("ClientOrders", fields: [clientId], references: [id])
  assignedCAId    String?
  assignedCA      User?         @relation("AssignedCAOrders", fields: [assignedCAId], references: [id])
  professionalFee Decimal       @db.Decimal(12, 2)
  govtFee         Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  clientState     String        @default("MH")
  intakeData      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  documents  VaultDocument[]
  invoices   Invoice[]
  ledger     LedgerEntry[]
  statusLogs OrderStatusLog[]
  payments   Payment[]
  messages   OrderMessage[]

  // Optional Organization & Legal Entity linkage
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  legalEntityId  String?
  legalEntity    LegalEntity?  @relation(fields: [legalEntityId], references: [id])
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  matters        Matter[]

  @@index([clientId])
  @@index([assignedCAId])
  @@index([organizationId])
  @@index([legalEntityId])
}

model Payment {
  id               String               @id @default(cuid())
  kind             PaymentKind
  status           PaymentAttemptStatus @default(CREATED)
  amount           Decimal              @db.Decimal(12, 2)
  // amount = taxableAmount + gstAmount + pass-through (govt fees / advocate fee collected on their behalf)
  taxableAmount    Decimal              @default(0) @db.Decimal(12, 2)
  gstAmount        Decimal              @default(0) @db.Decimal(12, 2)
  description      String
  gatewayOrderId   String?              @unique
  gatewayPaymentId String?              @unique
  orderId          String?
  order            Order?               @relation(fields: [orderId], references: [id])
  consultationId   String?
  consultation     Consultation?        @relation(fields: [consultationId], references: [id])
  capturedAt       DateTime?
  createdAt        DateTime             @default(now())

  invoice Invoice?
  refunds PaymentRefund[]

  @@index([orderId])
  @@index([consultationId])
}

model PaymentRefund {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundRequestId String   @unique // Stable internal refund request ID, e.g. "ref_req_appr_..."
  gatewayRefundId String?  @unique
  amount          Decimal  @db.Decimal(12, 2)
  status          String   @default("RESERVED") // RESERVED | SUCCEEDED | FAILED
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String // OrderStatus value or an event like DOCUMENT_UPLOADED
  remarks   String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false) // staff-only note, hidden from client
  isQuery    Boolean  @default(false) // staff query that needs a client response
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNo      String   @unique
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id])
  paymentId      String?  @unique
  payment        Payment? @relation(fields: [paymentId], references: [id])
  billedToName   String
  billedToGstin  String?
  placeOfSupply  String // state code
  sacCode        String   @default("998221")
  taxableAmount  Decimal  @db.Decimal(12, 2)
  cgst           Decimal  @default(0) @db.Decimal(12, 2)
  sgst           Decimal  @default(0) @db.Decimal(12, 2)
  igst           Decimal  @default(0) @db.Decimal(12, 2)
  reimbursements Decimal  @default(0) @db.Decimal(12, 2) // govt fees collected as pure agent (outside GST value)
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model LedgerEntry {
  id          String   @id @default(cuid())
  txnNo       String   @unique
  type        TxnType
  description String
  debit       Decimal  @default(0) @db.Decimal(12, 2)
  credit      Decimal  @default(0) @db.Decimal(12, 2)
  mode        String   @default("RAZORPAY")
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now())
}

// ==========================================
// DOCUMENT VAULT (private storage + access audit)
// ==========================================

model VaultDocument {
  id             String    @id @default(cuid())
  name           String
  requirementKey String? // ServiceDocRequirement.key this file satisfies
  storageKey     String    @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  version        Int       @default(1)
  supersedesId   String?   @unique
  supersedes     VaultDocument? @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy   VaultDocument? @relation("DocumentVersions")
  category       String
  status         DocStatus @default(PENDING_REVIEW)
  rejectNote     String?
  ownerId        String
  owner          User      @relation("DocumentOwner", fields: [ownerId], references: [id])
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reviewedById   String?
  reviewedBy     User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  uploadedAt     DateTime  @default(now())

  accessLogs        DocumentAccessLog[]
  statutoryEvidence StatutoryEvidence?

  @@index([orderId])
  @@index([ownerId])
  @@index([organizationId])
}

model StatutoryEvidence {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntityId     String?
  legalEntity       LegalEntity?  @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  documentId        String        @unique
  document          VaultDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  attestedStateCode String?       // Valid statutory 2-letter state code e.g. "MH", "KA"
  verifiedGstin     String?       // Valid 15-character statutory GSTIN
  scope             String        @default("REGISTERED_OFFICE") // REGISTERED_OFFICE | BRANCH
  isCurrent         Boolean       @default(true)
  reviewerId        String
  reviewer          User          @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId])
  @@index([legalEntityId])
  @@index([reviewerId])
}

model DocumentAccessLog {
  id         String        @id @default(cuid())
  documentId String
  document   VaultDocument @relation(fields: [documentId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  action     String // UPLOAD | DOWNLOAD | REVIEW
  ip         String?
  createdAt  DateTime      @default(now())

  @@index([documentId])
}

// ==========================================
// वकील SEARCH — LAWYER MARKETPLACE
// ==========================================

model PracticeArea {
  id      String          @id @default(cuid())
  slug    String          @unique
  name    String
  lawyers LawyerProfile[]
}

model LawyerProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id])
  slug                String             @unique
  barCouncil          String // e.g. "Bar Council of Maharashtra & Goa"
  enrollmentNo        String             @unique
  enrollmentYear      Int
  verification        LawyerVerification @default(PENDING)
  verificationNote    String?
  verifiedAt          DateTime?
  isListed            Boolean            @default(true)
  bio                 String
  city                String
  languages           String[]
  courts              String[]
  consultationFee     Decimal            @db.Decimal(12, 2)
  consultationMinutes Int                @default(30)
  modes               ConsultationMode[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  practiceAreas PracticeArea[]
  availability  AvailabilityRule[]
  timeOff       LawyerTimeOff[]
  consultations Consultation[]
  payouts       Payout[]

  @@index([city])
}

// Weekly recurring availability, expressed in IST minutes-from-midnight.
model AvailabilityRule {
  id          String        @id @default(cuid())
  lawyerId    String
  lawyer      LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  startMinute Int
  endMinute   Int

  @@index([lawyerId])
}

model LawyerTimeOff {
  id       String        @id @default(cuid())
  lawyerId String
  lawyer   LawyerProfile @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?
}

model Consultation {
  id            String             @id @default(cuid())
  number        String             @unique
  lawyerId      String
  lawyer        LawyerProfile      @relation(fields: [lawyerId], references: [id])
  clientId      String
  client        User               @relation("ClientConsultations", fields: [clientId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  mode          ConsultationMode
  status        ConsultationStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime? // unpaid bookings release the slot after this
  fee           Decimal            @db.Decimal(12, 2)
  platformFee   Decimal            @db.Decimal(12, 2)
  gstAmount     Decimal            @db.Decimal(12, 2)
  totalAmount   Decimal            @db.Decimal(12, 2)
  clientNotes   String? // intake: what the client needs help with
  lawyerNotes   String? // private to the lawyer
  meetingUrl    String?
  payoutId      String?
  payout        Payout?            @relation(fields: [payoutId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  payments Payment[]

  @@index([lawyerId, startsAt])
  @@index([clientId])
}

model Payout {
  id            String         @id @default(cuid())
  lawyerId      String
  lawyer        LawyerProfile  @relation(fields: [lawyerId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  status        PayoutStatus   @default(PENDING)
  reference     String? // bank UTR
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
  consultations Consultation[]
}


// ==========================================
// ERP / CRM MULTI-TENANCY & LEGAL ENTITIES
// ==========================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  FINANCE
}

enum EntityType {
  PRIVATE_LIMITED
  LLP
  ONE_PERSON_COMPANY
  PUBLIC_LIMITED
  SECTION_8
  PROPRIETORSHIP
  PARTNERSHIP
  TRUST_SOCIETY
  FOREIGN_SUBSIDIARY
}

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  stateCode   String   @default("UNKNOWN")
  gstin       String?
  pan         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            OrganizationMember[]
  entities           LegalEntity[]
  orders             Order[]
  matters            Matter[]
  vaultDocuments     VaultDocument[]
  statutoryEvidences StatutoryEvidence[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model LegalEntity {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName        String
  entityType       EntityType
  cin              String?      @unique
  pan              String?
  gstin            String?
  registeredOffice String?
  stateCode        String       @default("UNKNOWN")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orders             Order[]
  matters            Matter[]
  statutoryEvidences StatutoryEvidence[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

// ==========================================
// DYNAMIC CATALOG BUNDLES & CRM QUOTES
// ==========================================

enum CatalogStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

model Bundle {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  tagline        String
  category       String
  badge          String
  icon           String
  popular        Boolean       @default(false)
  targetAudience String
  description    String
  packagePrice   Decimal       @db.Decimal(12, 2)
  advanceToken   Decimal       @default(999) @db.Decimal(12, 2)
  sla            String
  status         CatalogStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          BundleItem[]
  quotes         Quote[]
}

model BundleItem {
  id              String   @id @default(cuid())
  bundleId        String
  bundle          Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service? @relation(fields: [serviceId], references: [id])
  slug            String
  name            String
  standalonePrice Decimal  @db.Decimal(12, 2)
  icon            String
  sortOrder       Int      @default(0)

  @@index([bundleId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

model Quote {
  id              String       @id @default(cuid())
  quoteNumber     String       @unique
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id])
  clientId        String?
  client          User?        @relation("ClientQuotes", fields: [clientId], references: [id])
  serviceId       String?
  service         Service?     @relation(fields: [serviceId], references: [id])
  bundleId        String?
  bundle          Bundle?      @relation(fields: [bundleId], references: [id])
  professionalFee Decimal      @db.Decimal(12, 2)
  govtFee         Decimal      @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal      @db.Decimal(12, 2)
  totalAmount     Decimal      @db.Decimal(12, 2)
  discountAmount  Decimal      @default(0) @db.Decimal(12, 2)
  validUntil      DateTime
  status          QuoteStatus  @default(DRAFT)
  snapshot        Json
  createdById     String?
  createdBy       User?        @relation("QuoteCreator", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          Order[]

  @@index([leadId])
  @@index([clientId])
}

// ==========================================
// STATUTORY MATTERS & DOMAIN STATE MACHINES
// ==========================================

enum MatterVertical {
  COMPANY_REGISTRATION
  TAXATION_GST_VCFO
  TRADEMARK_IPR
  LICENSES_PERMITS
  LEGAL_DISPUTES
  BUSINESS_TECH
}

enum MatterStatus {
  INTAKE_PENDING
  DOCS_COLLECTION
  PROFESSIONAL_REVIEW
  QUERY_COMMUNICATED
  FILING_PREPARED
  STATUTORY_SUBMITTED
  GOVERNMENT_QUERY_RESUBMIT
  STATUTORY_APPROVED
  CERTIFICATE_ISSUED
  REJECTED_CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Matter {
  id                String          @id @default(cuid())
  matterNumber      String          @unique // e.g. "MAT-2026-0001"
  title             String
  vertical          MatterVertical
  status            MatterStatus    @default(INTAKE_PENDING)
  statutoryStatus   String?         // Actual government portal status (e.g. "SPICe+ Part B Resubmission")
  authorityName     String?         // "MCA_V3", "GSTN", "IP_INDIA", "FOSCOS", "DGFT", "CONSUMER_FORUM"
  srnArn            String?         // Official government SRN / ARN / TM application number
  filingTimestamp   DateTime?       // Actual portal submission timestamp
  statutoryDeadline DateTime?       // Departmental confirmed deadline
  orderId           String?
  order             Order?          @relation(fields: [orderId], references: [id])
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  legalEntityId     String?
  legalEntity       LegalEntity?    @relation(fields: [legalEntityId], references: [id])
  assignedLeadId    String?
  assignedLead      User?           @relation("AssignedLeadMatters", fields: [assignedLeadId], references: [id])
  complianceExecId  String?
  complianceExec    User?           @relation("AssignedExecMatters", fields: [complianceExecId], references: [id])
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tasks             MatterTask[]
  evidenceFiles     MatterEvidence[]

  @@index([orderId])
  @@index([organizationId])
  @@index([assignedLeadId])
  @@index([complianceExecId])
}

model MatterTask {
  id           String     @id @default(cuid())
  matterId     String
  matter       Matter     @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  status       TaskStatus @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([matterId])
}

model MatterEvidence {
  id           String   @id @default(cuid())
  matterId     String
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title        String
  category     String   // "CHALLAN", "PORTAL_RECEIPT", "GOVT_QUERY", "CERTIFICATE"
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([matterId])
}

// ==========================================
// DOUBLE-ENTRY GENERAL LEDGER (GL)
// ==========================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique // e.g. "1001", "2001", "4001"
  name      String
  type      AccountType
  currency  String      @default("INR")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines     JournalLine[]
}

model JournalEntry {
  id            String        @id @default(cuid())
  entryNo       String        @unique // e.g. "JE-2026-0001"
  date          DateTime      @default(now())
  description   String
  referenceType String        // "PAYMENT", "REFUND", "GOVT_FEE_DISBURSEMENT", "MANUAL_ADJUSTMENT"
  referenceId   String?
  status        JournalStatus @default(POSTED)
  isTest        Boolean       @default(false)
  createdById   String?
  createdBy     User?         @relation("JournalCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?         @relation("JournalApprover", fields: [approvedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines         JournalLine[]

  @@index([referenceType, referenceId])
  @@index([date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

// ==========================================
// MAKER-CHECKER APPROVAL DESK & AUDIT LOGS
// ==========================================

enum ApprovalType {
  REFUND
  CATALOG_PRICE_CHANGE
  MANUAL_LEDGER_ADJUSTMENT
  PAYOUT_DISBURSEMENT
  RULE_OVERRIDE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  title       String
  reason      String
  payload     Json
  requesterId String
  requester   User           @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewerId  String?
  reviewer    User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([requesterId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  action     String   // e.g. "CATALOG_UPDATE", "PII_UNMASK", "REFUND_REQUESTED", "RBAC_ESCALATE"
  entityType String   // "Service", "Order", "Lead", "LedgerEntry", "User"
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
